name:           sylow-solver
version:        0.1.0.0
build-type:     Simple
cabal-version:  >=1.10

executable sylow-solver
  main-is:             Main.hs
  hs-source-dirs:      app, src
  other-modules:       Auto
                     , Core
                     , DisjunctionHash
                     , Env
                     , EnvPrint
                     , NumberTheory
                     , Predicates
                     , Theorems
  default-language:    Haskell2010
  build-depends:       base >=4.14 && <5
                     , containers
                     , hashable
